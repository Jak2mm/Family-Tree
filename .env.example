# Copy this file to ".env" (same folder) and change the values for your home.

# Where the NAS share is mounted on this VM (no slash at the end). It must contain the folders
# "photos" and "backups" and an empty file called ".family-tree-nas-ok" (see README, step 2c).
NAS_MOUNT=/mnt/nas/family-tree

# Your time zone, so backups run at the times you pick. Examples: Australia/Sydney, Australia/Perth,
# Europe/London, America/New_York.
TIMEZONE=Australia/Sydney

# Who can open the app. 127.0.0.1 means this VM only (safest). Use it together with
# "tailscale serve" (README, step 4). Or put this VM's Tailscale address (starts with 100.) to
# reach the app directly over Tailscale without the extra step (this can fail after a reboot if Docker starts before Tailscale; see README). Never use 0.0.0.0.
BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# Set to true if you open the app through an https:// address (that is what "tailscale serve"
# gives you). Leave false if you open it with plain http://100.x.x.x:8000, or you will not be
# able to sign in.
COOKIE_SECURE=false

# The user number and group number the app runs as. 1000 is fine unless the NAS refuses to let
# that user write. Then use the numbers of the NAS user who owns the folder, BEFORE the first start (README, step 2d).
PUID=1000
PGID=1000
